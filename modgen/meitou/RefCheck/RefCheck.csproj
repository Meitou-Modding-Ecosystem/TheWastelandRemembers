<Project Sdk="Microsoft.NET.Sdk">
  <!-- release_check.sh: the engine members the SHIPPED DLL (built against the oldest supported Meitou) calls, checked by name and parameter
       types against each release. Compiling against a release cannot catch these: a changed signature (0.21 gave Inventory.Add an optional
       parameter) breaks only the already-built DLL, at run time (MissingMethodException). -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net11.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup><PackageReference Include="System.Reflection.MetadataLoadContext" Version="11.0.0" /></ItemGroup>
</Project>
