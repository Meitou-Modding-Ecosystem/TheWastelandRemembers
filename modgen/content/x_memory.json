  {
   "id": "mem_uc_hate",
   "event": "EV_I_SEE_NEUTRAL_SQUAD",
   "factions": [
    "United Cities"
   ],
   "player_only": true,
   "chance": 35,
   "repeat": 2,
   "one_at_a_time": true,
   "if": [
    {
     "cond": "DC_I_HATE_THIS_GUY",
     "who": "target",
     "value": 1
    },
    {
     "cond": "DC_IS_SLAVE",
     "who": "me",
     "value": 0
    },
    {
     "cond": "DC_IN_COMBAT",
     "who": "me",
     "value": 0
    }
   ],
   "lines": [
    {
     "say": [
      "You. I know what you did to mine. The law may forget. I don't.",
      "Keep walking. My people remember you, and so do I.",
      "There you are. We have a debt, you and I. Not today."
     ]
    }
   ]
  },
  {
   "id": "mem_uc_love",
   "event": "EV_I_SEE_NEUTRAL_SQUAD",
   "factions": [
    "United Cities"
   ],
   "player_only": true,
   "chance": 35,
   "repeat": 2,
   "one_at_a_time": true,
   "if": [
    {
     "cond": "DC_I_LOVE_THIS_GUY",
