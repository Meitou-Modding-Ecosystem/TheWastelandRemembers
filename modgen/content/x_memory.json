     "value": 0
    },
    {
     "cond": "DC_IN_COMBAT",
     "who": "me",
     "value": 0
    }
   ],
   "lines": [
    {
     "say": [
      "You. You pulled me out of that. I have not forgotten.",
      "The one who stood over me. I owe you, and the Cities will hear of it.",
      "I remember you. On your feet when I was not."
     ],
     "effects": [
