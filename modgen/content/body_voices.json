  {
   "id": "bv_leg_stoic",
   "event": "EV_LOST_LEG",
   "packages": [
    "player:all"
   ],
   "personality": "Brave",
   "repeat": 1,
   "if": [
    {
     "cond": "DC_IS_PLAYER",
     "who": "me",
     "value": 1
    }
   ],
   "lines": [
    {
     "say": [
      "Gone. Well. I have another.",
      "It was only a leg.",
      "Keep moving. I'll manage.",
      "Don't look at it. I haven't."
     ]
    }
   ]
  },
  {
