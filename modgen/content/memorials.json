 "dialogues": [
  {
   "id": "mm_mourn",
   "event": "EV_I_SEE_RAGDOLL",
   "packages": [
    "player:all"
   ],
   "chance": 100,
   "score": 20,
   "lw_if": [
    {
     "fallen_target": 1
    }
   ],
   "lines": [
    {
     "say": [
      "Rest easy, /YOURNAME/.",
      "/YOURNAME/. Not like this.",
      "Somebody close /YOURNAME/'s eyes. I can't.",
      "We'll remember you, /YOURNAME/. Somebody has to.",
      "/YOURNAME/... Get up. Get up, damn you."
     ]
    }
   ]
  },
  {
   "id": "mm_remember_town",
   "event": "EV_ENTER_TOWN",
   "packages": [
    "player:all"
   ],
   "chance": 25,
   "repeat": 3,
   "lw_if": [
    {
     "loss_days": "<",
     "value": 10
    }
   ],
   "lines": [
    {
     "say": [
      "Nobody's joked at the fire since we lost one /LWLOSS/.",
      "We left one of ours /LWLOSS/.",
      "Another town. Wish they'd all made it this far.",
      "First drink's for the one we lost."
     ]
    }
   ]
  },
  {
   "id": "mm_after_win",
   "event": "EV_I_DEFEATED_SQUAD",
   "packages": [
    "player:all"
   ],
   "chance": 25,
   "repeat": 3,
   "lw_if": [
    {
     "loss_days": "<",
     "value": 20
    }
   ],
   "lines": [
    {
     "say": [
      "That one was for the ones we lost.",
      "Feels no better. It never does.",
      "Still one short. Always will be."
     ]
    }
   ]
  },
  {
   "id": "mm_feud_sight",
   "event": "EV_I_SEE_NEUTRAL_SQUAD",
   "packages": [
    "player:all"
   ],
   "chance": 15,
   "repeat": 3,
   "lw_if": [
    {
     "feud_target": 1
    }
   ],
   "lines": [
    {
     "say": [
      "That lot killed one of ours.",
      "Watch them. They owe us blood.",
      "I know those colours. I won't forget them.",
      "Easy. Not here. Not yet."
     ]
    }
   ]
  },
  {
   "id": "mm_scar_arm",
   "event": "EV_ENTER_TOWN",
   "packages": [
    "player:all"
   ],
   "chance": 60,
   "repeat": 2,
   "lw_if": [
    {
     "scar_here": 1
    }
   ],
   "lines": [
    {
     "say": [
      "This is where I left my arm.",
      "I walked in here with two arms once.",
      "Same town. Same smell. My arm's still here somewhere."
     ]
    }
   ]
  },
  {
   "id": "mm_scar_leg",
   "event": "EV_ENTER_TOWN",
   "packages": [
    "player:all"
   ],
   "chance": 60,
   "repeat": 2,
   "lw_if": [
    {
     "scar_here": 2
    }
   ],
   "lines": [
    {
     "say": [
      "Last time I came in here, I left on one leg.",
      "This place cost me a leg. I'll limp past, thanks.",
      "Watch the gate. Last time it wasn't the gate that got me."
     ]
    }
   ]
  },
  {
   "id": "mm_scar_down",
   "event": "EV_ENTER_TOWN",
   "packages": [
    "player:all"
   ],
   "chance": 40,
   "repeat": 2,
   "lw_if": [
    {
     "scar_here": 3
    }
   ],
   "lines": [
    {
     "say": [
      "Last time we were here I woke up in the dirt.",
      "I remember this place. From the ground, mostly.",
      "Keep your eyes open. This town owes me a beating."
     ]
    }
   ]
  }
 ]
