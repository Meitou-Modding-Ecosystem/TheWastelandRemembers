  {
   "id": "rm_tale_narko",
   "event": "EV_BAR_TALK",
   "factions": [
    "Traders Guild",
    "United Cities",
    "The Holy Nation",
    "Shek Kingdom",
    "Nomads",
    "Drifters",
    "Hounds",
