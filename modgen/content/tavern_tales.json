   "chance": 8,
   "repeat": 3,
   "lw_if": [
    {
     "tale": "narko"
    }
   ],
   "lines": [
    {
     "say": [
      "I heard a squad walked into Blister Hill and the Phoenix never walked out. The paladins won't say the name. Narko.",
      "The Holy Lord is dead. Not the Shek, not an army. A handful of drifters."
     ]
    }
   ]
  },
