{
 "pack": "lookout",
 "mod": "LivingWasteland",
 "meitou_only": true,
 "note": "Meitou only: lookout calls (Lookout.cs). The helper fires EV_SOUND_THE_ALARM (used by nothing else) on the squad member nearest a hostile person within 150 m; the line goes by the target's faction, a squadmate may answer. The generic line has the lowest score. An enemy squad marching in a nation's campaign (an army on its way to take a town, as Kenshi Ultimate Overhaul sends) gets the army lines first (lw_if marching, Marches.cs).",
 "dialogues": [
  {
   "id": "lk_army",
   "event": "EV_SOUND_THE_ALARM",
   "packages": [
    "player:all"
   ],
   "chance": 100,
   "repeat": 0,
   "score": 40,
   "lw_if": [
    {
     "marching": 1
    }
   ],
   "lines": [
    {
     "say": [
      "That's not a patrol. That's an army.",
      "/TARGETFACTION/ on the march. Somebody's town is about to burn.",
      "Column on the road. A big one.",
      "War party, moving fast. They're not here for us... yet.",
      "Look at them all. That's a whole army walking.",
      "Banners, marching order, the lot. /TARGETFACTION/ means business."
     ],
     "then": [
      {
       "say": [
        "Then we stay out of its way.",
        "Or we break it before it gets there.",
        "Where are they headed?",
        "Kill the one leading it and the rest scatter.",
        "Whoever they're marching on, I pity them.",
        "Keep low. Let it pass."
       ],
       "speaker": "T_INTERJECTOR1",
       "pct": 0
      }
     ]
    }
   ]
  },
