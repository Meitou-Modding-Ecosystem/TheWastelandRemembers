     [
      "Heng"
     ]
    ]
   }
  },
  {
   "kind": "start",
   "from": "holy nation citizen",
   "name": "The Quiet Resister",
   "str": {
    "difficulty": "Hard",
    "style": "RPG",
    "description": "You wear the faith the way everybody does. Under it you kept your own name, and a few small things of your own: a warning passed on, a loaf left on a step, a door left unlatched.\n\nThe priests have started counting heads. You decide to leave before yours is counted."
   },
   "int": {
    "money": 50
   }
  },
