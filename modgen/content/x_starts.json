   "name": "The Courier",
   "str": {
    "difficulty": "Default",
    "style": "RPG",
    "description": "You carried messages for people who could not trust anyone else to carry them. Mostly small things: a note, a coin, a keepsake. You never asked what was inside.\n\nThe pay is thin and the roads are not. But somebody always needs something taken somewhere."
   },
   "int": {
    "money": 300
   },
   "ref": {
